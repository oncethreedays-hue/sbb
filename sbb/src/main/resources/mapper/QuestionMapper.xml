<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mysite.sbb.question.mapper.QuestionMapper">

	<!-- DTO 생성자 매핑 -->
	<resultMap id="questionListMap"
		type="com.mysite.sbb.question.dto.QuestionResponseDto">
		<constructor>
			<idArg column="id" javaType="java.lang.Integer" />
			<arg column="subject" javaType="java.lang.String" />
			<arg column="create_date" javaType="java.time.LocalDateTime" />
			<arg column="author_username" javaType="java.lang.String" />
			<arg column="answer_count" javaType="_int" />
		</constructor>
	</resultMap>

	<!-- 검색 조건 공통 쿼리 분기 -->
	<sql id="searchCondition">
		<if test="kw != null and kw != ''">
			WHERE q.subject LIKE CONCAT('%', #{kw}, '%')
			   OR q.content LIKE CONCAT('%', #{kw}, '%')
		</if>
	</sql>

	<!-- 목록조회 (페이징 및 최신순 정렬) -->
	<select id="findAllByKeyword" resultMap="questionListMap">
		SELECT q.id,
		       q.subject,
		       q.create_date,
		       u.username AS author_username,
		       (SELECT COUNT(*) FROM answer a WHERE a.question_id = q.id) AS answer_count
		FROM question q
		LEFT JOIN site_user u ON q.author_id = u.id
		<include refid="searchCondition" />
		ORDER BY q.id DESC
		LIMIT #{limit} OFFSET #{offset}
	</select>

	<!-- 전체 개수 조회 (페이징 계산용) -->
	<select id="countByKeyword" resultType="long">
		SELECT COUNT(*)
		FROM question q
		<include refid="searchCondition" />
	</select>

</mapper>